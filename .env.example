# OpenAI
# Required for LLM-backed answers. Leave empty only when using deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TRACING_ENABLED=true

# Ollama
# Optional local CPU-only model runtime. Keep separate from OPENAI_* so both
# providers can be configured and used at the same time.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=ollama
OLLAMA_HOST_PORT=11434
OLLAMA_IMAGE_TAG=latest

# PostgreSQL
# If your local machine already uses port 5432, set POSTGRES_PORT=15432.
POSTGRES_PORT=5432
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
DATABASE_URL=postgresql://bookstore:bookstore@postgres:5432/bookstore

# MCP servers
CATALOG_MCP_PORT=8101
CATALOG_MCP_HOST_PORT=8101
CATALOG_MCP_URL=http://catalog-mcp:8101/mcp

CUSTOMER_MCP_PORT=8102
CUSTOMER_MCP_HOST_PORT=8102
CUSTOMER_MCP_URL=http://customer-mcp:8102/mcp

STORE_OPERATIONS_MCP_PORT=8103
STORE_OPERATIONS_MCP_HOST_PORT=8103
STORE_OPERATIONS_MCP_URL=http://store-operations-mcp:8103/mcp

# Agents
CUSTOMER_CONCIERGE_AGENT_PORT=8201
CUSTOMER_CONCIERGE_AGENT_HOST_PORT=8201
CUSTOMER_CONCIERGE_AGENT_URL=http://customer-concierge-agent:8201

STORE_MANAGER_AGENT_PORT=8202
STORE_MANAGER_AGENT_HOST_PORT=8202
STORE_MANAGER_AGENT_URL=http://store-manager-agent:8202

CATALOG_SPECIALIST_AGENT_PORT=8203
CATALOG_SPECIALIST_AGENT_HOST_PORT=8203
CATALOG_SPECIALIST_AGENT_URL=http://catalog-specialist-agent:8203

RESERVATION_SPECIALIST_AGENT_PORT=8204
RESERVATION_SPECIALIST_AGENT_HOST_PORT=8204
RESERVATION_SPECIALIST_AGENT_URL=http://reservation-specialist-agent:8204

MESSAGE_DRAFTER_AGENT_PORT=8205
MESSAGE_DRAFTER_AGENT_HOST_PORT=8205
MESSAGE_DRAFTER_AGENT_URL=http://message-drafter-agent:8205

# Frontend and gateway
FRONTEND_GATEWAY_PORT=8300
FRONTEND_GATEWAY_HOST_PORT=8300
FRONTEND_GATEWAY_PUBLIC_URL=http://localhost:8300

FRONTEND_HOST_PORT=3000

CHATKIT_API_PATH=/chatkit

# Approvals
APPROVAL_REQUIRED_FOR_WRITES=true
APPROVAL_STATE_STORE=postgres

# Logging
LOG_LEVEL=INFO

# Container image names
BACKEND_IMAGE_PREFIX=bookstore
FRONTEND_IMAGE_PREFIX=bookstore
IMAGE_TAG=local
